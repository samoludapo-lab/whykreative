NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
MAX_JSON_BYTES=65536

# Required in production
DATABASE_URL=postgres://renderops:renderops@localhost:5432/renderops
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters

# S3/R2 storage
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_BUCKET=renderops
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# AI/video providers
MESHY_API_KEY=
TRIPO_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=

# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
